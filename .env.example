# Copy to .env.local (never commit .env.local) and fill in real values.

# ── Database ────────────────────────────────────────────────────────────────
# Production / Vercel: a PostgreSQL connection string. With Supabase use the
# "Transaction pooler" string (port 6543) from Project Settings → Database.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Local development without any database server: embedded Postgres on disk.
DATABASE_URL=pglite:./.data/pglite

# Optional: PEM CA certificate to verify the database's TLS certificate
# (recommended in production; Supabase → Project Settings → Database → SSL).
# Newlines may be written as \n.
# DATABASE_CA_CERT=

# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5

# ── App ─────────────────────────────────────────────────────────────────────
# Optional: extra comma-separated origins allowed to make admin requests,
# if the site is served from more than one domain.
# APP_ORIGINS=https://leaderboard.example.org
